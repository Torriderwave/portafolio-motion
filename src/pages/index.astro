---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import { works, services, profile } from '../data/works';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const types = Array.from(new Set(works.map((w) => w.type)));
const count = (t: string) => (t === 'Todo' ? works.length : works.filter((w) => w.type === t).length);
const reel = profile.showreel;
const hasReel = Boolean(reel.embed || reel.video);
const isDemo = (w: (typeof works)[number]) => !w.thumb && !w.video && !w.embed;
---
<Base title={`${profile.name} · ${profile.tagline}`} description={profile.bio}>
  <header class="sticky top-0 z-30 border-b border-line/70 bg-bg/85 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5 text-sm">
      <a href="#top" class="font-display text-base font-bold tracking-tight">{profile.name}<span class="text-hot">.</span></a>
      <div class="flex items-center gap-5 text-mute sm:gap-7">
        <a class="hover:text-fg" href="#trabajo">Trabajo</a>
        <a class="hover:text-fg" href="#servicios">Servicios</a>
        <a class="hover:text-fg" href="#contacto">Contacto</a>
        <a class="hidden hover:text-fg sm:block" href={profile.dev}>Desarrollo ↗</a>
      </div>
    </nav>
  </header>

  <main id="top" class="mx-auto max-w-6xl px-5">
    <section class="pb-14 pt-16 sm:pt-24">
      <h1 class="rise max-w-4xl font-display text-4xl font-bold leading-[1.05] tracking-tight sm:text-6xl">
        Motion graphics y diseño para marcas <span class="text-hot">que se mueven.</span>
      </h1>
      <p class="rise mt-6 max-w-xl text-lg text-mute" style="animation-delay:.1s">{profile.bio}</p>
      <div class="rise mt-8 flex flex-wrap gap-3 text-sm" style="animation-delay:.2s">
        <a href="#trabajo" class="rounded-full bg-fg px-5 py-2.5 font-medium text-bg transition hover:bg-hot hover:text-white">Ver trabajo</a>
        <a href="#contacto" class="rounded-full border border-line px-5 py-2.5 transition hover:border-fg">Contacto</a>
      </div>
    </section>

    <section aria-label="Showreel" class="pb-20">
      <div class="relative aspect-video w-full overflow-hidden rounded-2xl border border-line bg-panel">
        {hasReel
          ? (reel.embed
              ? <iframe src={reel.embed} class="absolute inset-0 h-full w-full" allowfullscreen title="Showreel" loading="lazy"></iframe>
              : <video src={`${base}/media/${reel.video}`} controls playsinline class="absolute inset-0 h-full w-full"></video>)
          : (<>
              <Art color="#ff5b3a" />
              <div class="absolute inset-x-0 bottom-0 flex items-center justify-between bg-gradient-to-t from-black/60 to-transparent p-5 text-sm">
                <span class="font-display text-lg font-bold">Showreel</span>
                <span class="rounded-full bg-black/40 px-3 py-1 text-xs backdrop-blur">Próximamente</span>
              </div>
            </>)}
      </div>
    </section>

    <section id="trabajo" class="scroll-mt-20 pb-20">
      <div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-4">
        <h2 class="font-display text-2xl font-bold">Trabajo seleccionado</h2>
        <div class="flex flex-wrap gap-1 text-sm" role="group" aria-label="Filtrar por tipo">
          {['Todo', ...types].map((t, i) => (
            <button type="button" data-filter={t} aria-pressed={i === 0} class="filter rounded-full px-3 py-1 text-mute transition hover:text-fg aria-pressed:bg-fg aria-pressed:text-bg">
              {t} <span class="text-xs opacity-60">{count(t)}</span>
            </button>
          ))}
        </div>
      </div>

      <ul class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2">
        {works.map((w) => (
          <li class="work" data-type={w.type}>
            <button type="button" data-slug={w.slug} class="open group block w-full text-left">
              <div class="relative aspect-video overflow-hidden rounded-xl border border-line bg-panel">
                {w.thumb
                  ? <img src={`${base}/media/${w.thumb}`} alt="" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]" />
                  : <Art color={w.color} />}
                {w.video && <video src={`${base}/media/${w.video}`} muted loop playsinline preload="none" class="preview absolute inset-0 h-full w-full object-cover opacity-0 transition group-hover:opacity-100"></video>}
                {isDemo(w) && <span class="absolute right-3 top-3 rounded-full bg-black/50 px-2.5 py-0.5 text-[11px] backdrop-blur">Ejemplo</span>}
                {(w.video || w.embed) && <span class="absolute bottom-3 left-3 grid h-9 w-9 place-items-center rounded-full bg-hot text-xs text-white" aria-hidden="true">▶</span>}
              </div>
              <div class="mt-3 flex items-baseline justify-between gap-4">
                <h3 class="font-display text-lg font-semibold transition group-hover:text-hot">{w.title}</h3>
                <span class="shrink-0 text-sm text-mute">{w.type} · {w.year}</span>
              </div>
            </button>
          </li>
        ))}
      </ul>
    </section>

    <section id="servicios" class="scroll-mt-20 border-t border-line py-16">
      <h2 class="font-display text-2xl font-bold">Qué hago</h2>
      <ul class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s) => (
          <li class="bg-bg p-6">
            <h3 class="font-display text-lg font-semibold">{s.name}</h3>
            <p class="mt-2 text-sm text-mute">{s.text}</p>
            <p class="mt-4 text-xs text-mute/80">{s.tools}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="contacto" class="scroll-mt-20 border-t border-line py-20">
      <h2 class="max-w-3xl font-display text-4xl font-bold leading-tight tracking-tight sm:text-6xl">¿Tienes algo en mente? <span class="text-hot">Hablemos.</span></h2>
      <div class="mt-8 flex flex-wrap items-center gap-3 text-sm">
        {profile.email && <a class="rounded-full bg-fg px-5 py-2.5 font-medium text-bg hover:bg-hot hover:text-white" href={`mailto:${profile.email}`}>{profile.email}</a>}
        <a class="rounded-full border border-line px-5 py-2.5 hover:border-fg" href={profile.github}>GitHub ↗</a>
        <a class="rounded-full border border-line px-5 py-2.5 hover:border-fg" href={profile.dev}>Portafolio de desarrollo ↗</a>
      </div>
    </section>
  </main>
  <footer class="border-t border-line py-6 text-center text-xs text-mute">© {new Date().getFullYear()} {profile.name}</footer>

  <dialog id="modal" aria-labelledby="m-title" class="m-auto max-h-[92vh] w-[min(980px,94vw)] overflow-auto rounded-2xl border border-line bg-panel p-0 text-fg">
    <div class="sticky top-0 z-10 flex items-center justify-between border-b border-line bg-panel/95 px-4 py-2 backdrop-blur">
      <div class="flex gap-1">
        <button id="m-prev" type="button" aria-label="Anterior" class="rounded px-3 py-1 text-mute hover:text-fg">←</button>
        <button id="m-next" type="button" aria-label="Siguiente" class="rounded px-3 py-1 text-mute hover:text-fg">→</button>
      </div>
      <button id="m-close" type="button" aria-label="Cerrar" class="rounded px-3 py-1 text-xl text-mute hover:text-fg">✕</button>
    </div>
    <div id="m-body" class="p-5 sm:p-6"></div>
  </dialog>

  <script is:inline define:vars={{ works, base }}>
    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const buttons = [...document.querySelectorAll('.filter')];
    const items = [...document.querySelectorAll('.work')];
    buttons.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.filter;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      items.forEach((i) => { i.hidden = f !== 'Todo' && i.dataset.type !== f; });
    }));

    // vista previa en hover
    document.querySelectorAll('.open').forEach((el) => {
      const v = el.querySelector('.preview'); if (!v) return;
      el.addEventListener('mouseenter', () => v.play().catch(() => {}));
      el.addEventListener('mouseleave', () => { v.pause(); v.currentTime = 0; });
    });

    const modal = document.getElementById('modal'), body = document.getElementById('m-body');
    let cur = 0;
    const visible = () => works.map((w, i) => i).filter((i) => !items[i].hidden);
    function show(i) {
      const w = works[i]; cur = i;
      let media;
      if (w.embed) media = `<div class="aspect-video overflow-hidden rounded-xl bg-black"><iframe src="${esc(w.embed)}" class="h-full w-full" allowfullscreen title="${esc(w.title)}"></iframe></div>`;
      else if (w.video) media = `<video src="${base}/media/${esc(w.video)}" controls autoplay playsinline class="w-full rounded-xl bg-black"></video>`;
      else if (w.thumb) media = `<img src="${base}/media/${esc(w.thumb)}" alt="${esc(w.title)}" class="w-full rounded-xl" />`;
      else media = `<div class="relative aspect-video overflow-hidden rounded-xl"><div class="art" style="--c:${esc(w.color)}"><i class="a1"></i><i class="a2"></i><i class="a3"></i></div></div>`;
      body.innerHTML = `${media}
        <div class="mt-5 grid gap-6 sm:grid-cols-[1fr_16rem]">
          <div><h3 id="m-title" class="font-display text-2xl font-bold">${esc(w.title)}</h3>
            <p class="mt-3 text-mute">${esc(w.description)}</p></div>
          <dl class="space-y-3 text-sm">
            <div><dt class="text-mute">Tipo</dt><dd>${esc(w.type)} · ${w.year}</dd></div>
            ${w.client ? `<div><dt class="text-mute">Cliente</dt><dd>${esc(w.client)}</dd></div>` : ''}
            <div><dt class="text-mute">Rol</dt><dd>${esc(w.role)}</dd></div>
            <div><dt class="text-mute">Herramientas</dt><dd>${w.tools.map(esc).join(', ')}</dd></div>
          </dl></div>`;
      if (!modal.open) modal.showModal();
      history.replaceState(null, '', '#' + w.slug);
    }
    function step(d) { const v = visible(); if (!v.length) return; const k = v.indexOf(cur); show(v[(k + d + v.length) % v.length]); }
    document.querySelectorAll('.open').forEach((el, i) => el.addEventListener('click', () => show(i)));
    document.getElementById('m-prev').addEventListener('click', () => step(-1));
    document.getElementById('m-next').addEventListener('click', () => step(1));
    document.getElementById('m-close').addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
    modal.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') step(-1); if (e.key === 'ArrowRight') step(1); });
    modal.addEventListener('close', () => { body.innerHTML = ''; history.replaceState(null, '', location.pathname + location.search); });
    const hi = works.findIndex((w) => '#' + w.slug === location.hash); if (hi >= 0) show(hi);
  </script>
</Base>
