---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import { works as allWorks, services, profile } from '../data/works';
import { CONTACT_URL } from '../data/contact';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
// Las fichas de plantilla (slug «ejemplo-N») no se publican; el dato queda intacto en works.ts.
const works = allWorks.filter((w) => !/^ejemplo-\d+$/.test(w.slug));
const hasWorks = works.length > 0;
const types = Array.from(new Set(works.map((w) => w.type)));
const contactHref = profile.email ? `mailto:${profile.email}` : CONTACT_URL;
const contactExt = !profile.email;
const ext = (on: boolean) => (on ? { target: '_blank', rel: 'noopener noreferrer' } : { rel: 'noopener' });
const count = (t: string) => (t === 'Todo' ? works.length : works.filter((w) => w.type === t).length);
const reel = profile.showreel;
const hasReel = Boolean(reel.embed || reel.video);
const isDemo = (w: (typeof works)[number]) => !w.thumb && !w.video && !w.embed;
const n = (i: number) => String(i + 1).padStart(2, '0');
const nav = [['trabajo', 'Trabajo'], ['servicios', 'Servicios'], ['contacto', 'Contacto']];
---
<Base title={`${profile.name} · ${profile.tagline}`} description={profile.bio}>
  <header class="site-header">
    <div class="wrap grid12 bar">
      <a class="brand" href="#top" aria-label={`${profile.name}, inicio`}>{profile.name}<b>.</b></a>
      <p class="bar-tag label">{profile.tagline}</p>
      <p class="bar-avail label"><span class="avail-dot" aria-hidden="true"></span>{profile.availability}</p>
      <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="nav"><span id="menu-lbl">Menú</span><span class="menu-ico" aria-hidden="true"></span></button>
      <nav class="nav" id="nav" aria-label="Principal">
        <ul>
          {nav.map(([id, label], i) => <li style={`--i:${i}`}><a href={`#${id}`}><span class="num">{n(i)}</span>{label}</a></li>)}
          <li style={`--i:${nav.length}`}><a href={profile.dev} rel="noopener"><span class="num">↗</span>Dev<span aria-hidden="true">&nbsp;↗</span><span class="sr-only"> (portafolio de desarrollo)</span></a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <div id="top"></div>
    <section class="wrap hero" aria-labelledby="h1">
      <div class="hero-top label">
        <span>Portafolio — {year}</span>
        <span class="mute">Motion · Diseño</span>
      </div>
      <h1 id="h1" class="display">
        <span class="ln"><span style="--i:0">Motion</span></span>
        <span class="ln"><span style="--i:1">graphics y</span></span>
        <span class="ln"><span style="--i:2">diseño<span class="red dot">.</span></span></span>
      </h1>
      <div class="hero-foot grid12 hl">
        <p class="label mute">(Perfil)</p>
        <p class="hero-lead">{profile.bio}</p>
        <div>
          <dl class="hero-meta label">
            <dt>Disciplinas</dt><dd>{services.map((x) => x.name).join(' · ')}</dd>
            {profile.location && <><dt>Ubicación</dt><dd>{profile.location}</dd></>}
          </dl>
          <a href={contactHref} class="cta" data-magnet data-cursor="Escribir" {...ext(contactExt)}><span>Escríbeme</span><span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="wrap" aria-label="Showreel" style="padding-bottom:var(--s7)">
      {hasReel
        ? (<>
            <div class="reel">
              {reel.embed
                ? <iframe src={reel.embed} allowfullscreen title="Showreel" loading="lazy"></iframe>
                : <video src={`${base}/media/${reel.video}`} controls muted playsinline preload="metadata"></video>}
            </div>
            <div class="reel-cap label"><span>Showreel {year}</span></div>
          </>)
        : <p class="reel-line"><span>Showreel {year} — pronto</span></p>}
    </section>

    <div class="mq" aria-hidden="true" data-live>
      <div class="mq-shift"><div class="mq-track">
        {[0, 1, 2].map(() => (
          <div class="mq-g">{services.map((s) => <span class="mq-i">{s.name}<i class="sq"></i></span>)}</div>
        ))}
      </div></div>
    </div>

    <section id="trabajo" class="wrap section" aria-labelledby="h-trabajo">
      <div class="grid12 sec-head hl hl-v">
        <span class="num">(01)</span>
        <h2 id="h-trabajo" class="mask"><span>Trabajo seleccionado</span></h2>
        {hasWorks && <span class="meta num">{String(works.length).padStart(2, '0')} {works.length === 1 ? 'proyecto' : 'proyectos'}</span>}
      </div>
      {!hasWorks && (
        <div class="prep" data-live>
          <p class="lead-empty">Selección en preparación<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span></p>
          <span class="prep-rule" aria-hidden="true"><i></i></span>
        </div>
      )}
      {hasWorks && (<>
      <div class="tools">
        <div class="chips" role="group" aria-label="Filtrar por tipo" data-slider>
          {['Todo', ...types].map((t, i) => (
            <button type="button" data-filter={t} aria-pressed={i === 0} class="chip">{t}<sup>{count(t)}</sup></button>
          ))}
          <span class="ind" aria-hidden="true"></span>
        </div>
        <div class="views" role="group" aria-label="Vista" data-slider>
          <button type="button" data-view="list" aria-pressed="true" class="chip">Lista</button>
          <button type="button" data-view="grid" aria-pressed="false" class="chip">Cuadrícula</button>
          <span class="ind" aria-hidden="true"></span>
        </div>
      </div>
      <p class="status" id="status" role="status" aria-live="polite">Mostrando {works.length} de {works.length}</p>

      <div class="grid12 work-layout">
        <ul id="works" class="works" data-view="list">
          {works.map((w, i) => (
            <li class="work rv" data-type={w.type} data-i={i} style={`--d:${Math.min(i, 5) * 0.06}s`}>
              <button type="button" data-slug={w.slug} class="open" data-cursor="Abrir" aria-haspopup="dialog">
                <span class="row">
                  <span class="n num">{n(i)}</span>
                  <span class="t">{w.title}<span class="sub">{w.type}</span></span>
                  <span class="ty">{w.type}</span>
                  <span class="yr num">{w.year}</span>
                </span>
                <span class="card">
                  <span class="card-media">
                    {w.thumb
                      ? <img src={`${base}/media/${w.thumb}`} alt={`${w.title} — ${w.type}, ${w.year}`} width="800" height="600" loading="lazy" decoding="async" />
                      : <Art color={w.color} type={w.type} />}
                    {isDemo(w) && <span class="badge">Ejemplo</span>}
                  </span>
                  <span class="card-cap">
                    <span class="num mute">{n(i)}</span>
                    <span class="t">{w.title}</span>
                    <span class="m">{w.type} · {w.year}</span>
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>

        <aside class="preview" aria-hidden="true">
          <div class="preview-in">
            <div id="pv-media" class="pv-media"></div>
            <div class="pv-cap"><span id="pv-title" class="t"></span><span id="pv-meta" class="mute num"></span></div>
            <p class="pv-hint">Pasa el cursor sobre un proyecto · clic para abrir</p>
          </div>
        </aside>
      </div>
          </>)}
    </section>

    <section id="servicios" class="wrap section" aria-labelledby="h-servicios">
      <div class="grid12 sec-head hl hl-v">
        <span class="num">(02)</span>
        <h2 id="h-servicios" class="mask"><span>Servicios</span></h2>
        <span class="meta num">{String(services.length).padStart(2, '0')} disciplinas</span>
      </div>
      <ul class="services">
        {services.map((s, i) => (
          <li class="svc rv hl hl-v" style={`--d:${i * 0.06}s`}>
            <span class="n num">{n(i)}</span>
            <h3>{s.name}<span class="arr" aria-hidden="true">→</span></h3>
            <p>{s.text}</p>
            <p class="tl">{s.tools}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="contacto" class="wrap section" aria-labelledby="h-contacto" style="padding-bottom:var(--s7)">
      <div class="grid12 sec-head hl hl-v">
        <span class="num">(03)</span>
        <h2 id="h-contacto" class="sr-only">Contacto</h2>
        <span class="meta"></span>
      </div>
      <p class="contact-big" aria-hidden="true"><span class="mw"><span>Hablemos</span></span> <span class="mw"><span>de</span></span> <span class="mw"><span>tu</span></span> <span class="mw"><span>proyecto<span class="redt">.</span></span></span></p>
      <a class="cta-big rv" data-magnet data-cursor="Escribir" href={contactHref} {...ext(contactExt)}><span>{profile.email ? profile.email : 'Escríbeme por LinkedIn'}</span><span aria-hidden="true">{profile.email ? '→' : '↗'}</span></a>
      <ul class="links">
                <li><a class="link-row hl hl-v" data-cursor="Visitar" href={profile.github} rel="noopener"><span>GitHub<small>Código y proyectos</small></span><span class="arr" aria-hidden="true">↗</span></a></li>
        <li><a class="link-row hl hl-v" data-cursor="Visitar" href={profile.dev} rel="noopener"><span>Portafolio de desarrollo<small>Proyectos de software</small></span><span class="arr" aria-hidden="true">↗</span></a></li>
      </ul>
    </section>
  </main>

  <footer class="wrap grid12 site-footer hl hl-v">
    <p>© {year} {profile.name}</p>
    <ul aria-label="Enlaces">
      {nav.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      <li><a href={profile.dev} rel="noopener">Portafolio de desarrollo ↗</a></li>
      <li><a href={profile.github} rel="noopener">GitHub ↗</a></li>
    </ul>
    <a href="#top" class="up-link">Volver arriba <span class="up" aria-hidden="true">↑</span></a>
  </footer>

  {hasWorks && <dialog id="modal" aria-labelledby="m-title">
    <div class="m-bar">
      <div><button id="m-prev" type="button" class="m-btn">← Anterior</button><button id="m-next" type="button" class="m-btn">Siguiente →</button></div>
      <div><span id="m-count" class="m-count num"></span><button id="m-close" type="button" class="m-btn">Cerrar ✕</button></div>
    </div>
    <div id="m-body" class="m-body"></div>
  </dialog>}

  <script is:inline define:vars={{ works, base }}>
    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const art = (w) => `<div class="art" data-t="${esc(w.type)}" style="--c:${esc(w.color)}" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i></div>`;
    const mediaOf = (w, big) => {
      if (big && w.demo) return demoOf(w);
      if (big && w.embed) return `<iframe src="${esc(w.embed)}" allowfullscreen title="${esc(w.title)}"></iframe>`;
      if (big && w.video) return `<video src="${base}/media/${esc(w.video)}" controls ${reduce ? '' : 'autoplay muted'} playsinline></video>`;
      if (w.thumb) return `<img src="${base}/media/${esc(w.thumb)}" alt="${esc(w.title)} — ${esc(w.type)}, ${w.year}" />`;
      return art(w);
    };

    /* Demo viva: el iframe solo existe mientras la ficha está abierta (show() lo monta, close/step lo desmonta con body.innerHTML) */
    const demoSrc = (w) => `${base}/demos/${esc(w.demo)}`;
    const demoOf = (w) => `<iframe class="demo" src="${demoSrc(w)}" title="${esc(w.title)} — demo" loading="lazy" referrerpolicy="no-referrer"></iframe>`;
    const rec = (w) => `<video src="${base}/media/${esc(w.video)}" poster="${base}/media/${esc(w.thumb)}" controls loop muted playsinline preload="none" aria-label="${esc(w.title)} — grabación"></video>`;
    /* Vista previa al pasar el cursor: mp4 con preload="none", se crea y reproduce solo al hover (nunca con movimiento reducido) */
    const hoverVid = (host, w) => {
      if (reduce || !w.video || !matchMedia('(hover: hover)').matches) return null;
      let v = host.querySelector('video.hv');
      if (!v) {
        v = document.createElement('video');
        v.className = 'hv'; v.muted = true; v.loop = true; v.playsInline = true; v.preload = 'none'; v.setAttribute('aria-hidden', 'true'); v.tabIndex = -1;
        v.src = `${base}/media/${w.video}`;
        /* spots 16:9 y 9:16: sin recorte, con el color de la pieza de fondo (el resto conserva cover) */
        if (w.hoverFit === 'contain') { v.classList.add('hv-contain'); v.style.backgroundColor = w.color; }
        v.addEventListener('playing', () => v.classList.add('on'));
        host.append(v);
      }
      return v;
    };
    const playHover = (host, w) => { const v = hoverVid(host, w); if (v) v.play().catch(() => {}); };
    const stopHover = (host) => { const v = host.querySelector('video.hv'); if (v) { v.pause(); v.classList.remove('on'); v.currentTime = 0; } };

    /* Arte: animar solo cuando está en pantalla */
    const artIO = 'IntersectionObserver' in window && !reduce
      ? new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('on', e.isIntersecting)), { rootMargin: '40px' }) : null;
    const watchArt = (root) => artIO && root.querySelectorAll('.art').forEach((a) => artIO.observe(a));
    watchArt(document);

    const sd = document.documentElement.classList.contains('sd');
    const raf = (f) => requestAnimationFrame(f);

    /* Reveal / hairlines / máscaras: nativo con view() (clase .sd); si no, IntersectionObserver mínimo */
    const rvs = [...document.querySelectorAll('.rv, .hl-v, .mask, .mw')];
    if (!sd) {
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
        rvs.forEach((el) => io.observe(el));
      } else rvs.forEach((el) => el.classList.add('in'));
    }

    /* Elementos con animación infinita: solo corren mientras están en pantalla */
    if ('IntersectionObserver' in window) {
      const lv = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('live', e.isIntersecting)), { rootMargin: '80px' });
      document.querySelectorAll('[data-live]').forEach((el) => lv.observe(el));
    }

    /* Indicador deslizante (transform-only): sitúa una barra bajo un elemento */
    const place = (ind, el) => {
      if (!el) { ind.style.opacity = '0'; return; }
      const cs = getComputedStyle(el), l = parseFloat(cs.paddingLeft) || 0, r = parseFloat(cs.paddingRight) || 0;
      ind.style.opacity = '1';
      ind.style.transform = `translate(${el.offsetLeft + l}px, ${el.offsetTop + el.offsetHeight - (parseFloat(ind.dataset.b) || 10)}px) scaleX(${Math.max(1, el.offsetWidth - l - r)})`;
    };
    const sliders = [];
    const mkSlider = (group, ind, cur) => {
      const s = { group, ind, cur, go: () => place(ind, cur()) };
      sliders.push(s); s.go();
      raf(() => raf(() => ind.classList.add('ready')));
      return s;
    };
    addEventListener('resize', () => raf(() => sliders.forEach((s) => s.go())), { passive: true });
    document.fonts && document.fonts.ready.then(() => sliders.forEach((s) => s.go()));

    /* Menú móvil */
    const mb = document.getElementById('menu-btn'), nav = document.getElementById('nav'), ml = document.getElementById('menu-lbl');
    const setMenu = (o) => { nav.classList.toggle('open', o); mb.setAttribute('aria-expanded', String(o)); ml.textContent = o ? 'Cerrar' : 'Menú'; };
    mb.addEventListener('click', () => setMenu(mb.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => { if (e.target.closest('a')) setMenu(false); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && mb.getAttribute('aria-expanded') === 'true') { setMenu(false); mb.focus(); } });
    matchMedia('(min-width: 900px)').addEventListener('change', (m) => { if (m.matches) setMenu(false); });

    /* Sección activa en la navegación + indicador deslizante (escritorio) */
    const links = [...nav.querySelectorAll('a[href^="#"]')];
        const navInd = document.createElement('span'); navInd.className = 'ind'; navInd.setAttribute('aria-hidden', 'true'); navInd.dataset.b = '9'; nav.append(navInd);
    const curLink = () => links.find((a) => a.getAttribute('aria-current') === 'true') || null;
    const navS = mkSlider(nav, navInd, curLink);
    links.forEach((a) => {
      a.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') place(navInd, a); });
      a.addEventListener('focus', () => place(navInd, a));
      a.addEventListener('pointerleave', navS.go);
      a.addEventListener('blur', navS.go);
    });
    if ('IntersectionObserver' in window) {
      const so = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.getAttribute('href') === '#' + e.target.id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current'));
        navS.go();
      }), { rootMargin: '-45% 0px -50% 0px' });
      document.querySelectorAll('main > section').forEach((s) => so.observe(s));
    }

    /* Cursor con etiqueta y CTA magnético: solo puntero fino, sin movimiento reducido */
    if (!reduce && matchMedia('(pointer: fine) and (hover: hover)').matches) {
      const c = document.createElement('div'); c.className = 'cursor'; c.setAttribute('aria-hidden', 'true');
      const ct = document.createElement('span'); c.append(ct); document.body.append(c);
      let px = 0, py = 0, label = '', pend = false;
      const flush = () => { pend = false; c.style.transform = `translate3d(${px}px, ${py}px, 0)`; };
      addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        px = e.clientX; py = e.clientY; c.classList.toggle('flip', px > innerWidth - 160);
        if (!pend) { pend = true; raf(flush); }
      }, { passive: true });
      document.addEventListener('pointerover', (e) => {
        if (e.pointerType !== 'mouse') return;
        const t = e.target.closest && e.target.closest('[data-cursor]');
        if (t) { if (t.dataset.cursor !== label) { label = t.dataset.cursor; ct.textContent = label; } c.classList.add('on'); } else c.classList.remove('on');
      }, { passive: true });
      document.documentElement.addEventListener('pointerleave', () => c.classList.remove('on'));

      document.querySelectorAll('[data-magnet]').forEach((el) => {
        let rect = null, mx = 0, my = 0, p2 = false;
        const move = () => { p2 = false; rect = rect || el.getBoundingClientRect(); const dx = (mx - rect.left) / rect.width - .5, dy = (my - rect.top) / rect.height - .5; el.style.setProperty('--mx', (dx * 10).toFixed(1) + 'px'); el.style.setProperty('--my', (dy * 6).toFixed(1) + 'px'); };
        el.addEventListener('pointermove', (e) => { mx = e.clientX; my = e.clientY; if (!p2) { p2 = true; raf(move); } }, { passive: true });
        el.addEventListener('pointerenter', () => { rect = null; });
        el.addEventListener('pointerleave', () => { el.style.removeProperty('--mx'); el.style.removeProperty('--my'); rect = null; });
      });
    }

    /* Filtros, vista, vista previa */
    if (!document.getElementById('works')) { /* sin proyectos publicados */ } else {
    const list = document.getElementById('works'), status = document.getElementById('status');
    const items = [...document.querySelectorAll('.work')];
    const fbtn = [...document.querySelectorAll('button[data-filter]')], vbtn = [...document.querySelectorAll('button[data-view]')];
    const pressed = (arr) => () => arr.find((x) => x.getAttribute('aria-pressed') === 'true');
    const fs = mkSlider(null, document.querySelector('.chips .ind'), pressed(fbtn));
    const vs = mkSlider(null, document.querySelector('.views .ind'), pressed(vbtn));
    const setView = (v) => { list.dataset.view = v; vbtn.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.view === v))); vs.go(); };
    if (matchMedia('(max-width: 1023px)').matches) setView('grid');
    let busy = 0;
    const applyFilter = (f) => {
      const ok = (i) => f === 'Todo' || i.dataset.type === f;
      const next = items.filter(ok), shown = items.filter((i) => !i.hidden);
      status.textContent = `Mostrando ${next.length} de ${items.length}`;
      clearTimeout(busy);
      const finish = () => {
        items.forEach((i) => { i.hidden = !ok(i); i.classList.remove('fx-out', 'fx-in'); });
        void list.offsetWidth;
        next.forEach((i, k) => { i.style.setProperty('--k', k); i.classList.add('fx-in'); });
      };
      if (reduce || !shown.length) return finish();
      shown.forEach((i) => i.classList.add('fx-out'));
      busy = setTimeout(finish, 170);
    };
    fbtn.forEach((b) => b.addEventListener('click', () => {
      fbtn.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      fs.go(); applyFilter(b.dataset.filter);
    }));
    vbtn.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view)));

    const pvm = document.getElementById('pv-media'), pvt = document.getElementById('pv-title'), pvmeta = document.getElementById('pv-meta');
    let pvi = -1;
    const preview = (i) => {
      if (i === pvi) return; pvi = i; const w = works[i];
      pvm.innerHTML = mediaOf(w, false); watchArt(pvm); playHover(pvm, w);
      pvt.textContent = w.title; pvmeta.textContent = `${w.type} · ${w.year}`;
      items.forEach((el, k) => k === i ? el.setAttribute('data-active', '') : el.removeAttribute('data-active'));
    };
    items.forEach((el, i) => {
      el.addEventListener('mouseenter', () => { preview(i); if (list.dataset.view === 'grid') playHover(el.querySelector('.card-media'), works[i]); });
      el.addEventListener('mouseleave', () => stopHover(el.querySelector('.card-media')));
      el.addEventListener('focusin', () => preview(i));
    });
    if (works.length) preview(0);

    /* Modal */
    const modal = document.getElementById('modal'), body = document.getElementById('m-body'), mcount = document.getElementById('m-count');
    let cur = 0, opener = null, closing = 0;
    const visible = () => items.map((_, i) => i).filter((i) => !items[i].hidden);
    function show(i) {
      const w = works[i]; cur = i;
      body.innerHTML = `<div class="m-media" data-ratio="${esc(w.ratio || '16:9')}">${mediaOf(w, true)}</div>
        ${w.demo && w.video ? `<p class="m-alt"><button type="button" class="m-btn" data-alt aria-pressed="false">Ver grabación</button><span class="mute">Demo en vivo · ${esc(w.ratio || '16:9')}</span></p>` : ''}
        <div class="m-grid grid12">
          <h2 id="m-title" class="m-title">${esc(w.title)}</h2>
          <dl class="m-dl">
            <div><dt>Tipo · Año</dt><dd>${esc(w.type)} · ${w.year}</dd></div>
            ${w.client ? `<div><dt>Cliente</dt><dd>${esc(w.client)}</dd></div>` : ''}
            <div><dt>Rol</dt><dd>${esc(w.role)}</dd></div>
            <div><dt>Herramientas</dt><dd>${w.tools.map(esc).join(', ')}</dd></div>
          </dl>
        </div>
        <p class="m-desc">${esc(w.description)}</p>`;
      mcount.textContent = `${String(i + 1).padStart(2, '0')} / ${String(works.length).padStart(2, '0')}`;
      watchArt(body);
      if (w.demo) wireDemo(w);
      if (!modal.open) { opener = document.activeElement; modal.showModal(); }
      document.getElementById('m-close').focus();
      modal.scrollTop = 0;
      history.replaceState(null, '', '#' + w.slug);
    }
    /* Alternar demo en vivo ↔ grabación (la demo se desmonta al cambiar a la grabación); si el iframe no carga en 7 s, cae a la grabación */
    function wireDemo(w) {
      const box = body.querySelector('.m-media'), btn = body.querySelector('[data-alt]');
      if (!box || !btn) return;
      let live = true, loaded = false, timer = 0;
      const set = (on, user) => {
        live = on; clearTimeout(timer);
        btn.setAttribute('aria-pressed', String(!on)); btn.textContent = on ? 'Ver grabación' : 'Ver demo en vivo';
        box.innerHTML = on ? demoOf(w) : rec(w);
        if (on) { loaded = false; box.querySelector('iframe').addEventListener('load', () => { loaded = true; }); timer = setTimeout(() => { if (!loaded && live) set(false); }, 7000); }
        else if (user && !reduce) box.querySelector('video').play().catch(() => {});
      };
      btn.addEventListener('click', () => set(!live, true));
      const f = box.querySelector('iframe'); f.addEventListener('load', () => { loaded = true; });
      timer = setTimeout(() => { if (!loaded && live) set(false); }, 7000);
    }
    function step(d) { const v = visible(); if (!v.length) return; show(v[(v.indexOf(cur) + d + v.length) % v.length]); }
    items.forEach((el, i) => el.querySelector('.open').addEventListener('click', () => show(i)));
    document.getElementById('m-prev').addEventListener('click', () => step(-1));
    document.getElementById('m-next').addEventListener('click', () => step(1));
    const closeModal = () => {
      if (!modal.open || closing) return;
      if (reduce) return modal.close();
      closing = 1; modal.setAttribute('data-closing', '');
      setTimeout(() => { modal.removeAttribute('data-closing'); closing = 0; modal.close(); }, 230);
    };
    document.getElementById('m-close').addEventListener('click', closeModal);
    modal.addEventListener('cancel', (e) => { e.preventDefault(); closeModal(); });
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    modal.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') step(-1); if (e.key === 'ArrowRight') step(1); });
    modal.addEventListener('close', () => { body.innerHTML = ''; history.replaceState(null, '', location.pathname + location.search); if (opener && opener.isConnected) opener.focus(); opener = null; });
    const hi = works.findIndex((w) => '#' + w.slug === location.hash); if (hi >= 0) show(hi);
    }
  </script>
</Base>
